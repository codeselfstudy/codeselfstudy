---
interface Props {
  class?: string;
  /** Opt out of the ~68ch reading measure for grid/table/wide layouts. */
  wide?: boolean;
}

const { class: className = "", wide = false } = Astro.props;
---

<div
  class:list={["container mx-auto px-4 pt-24 pb-12 sm:px-6 lg:px-8", className]}
>
  <div class:list={[!wide && "max-w-[68ch]"]}>
    <slot />
  </div>
</div>
