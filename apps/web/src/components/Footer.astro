---
// Year rendered at build time; a small inline script below refreshes it on
// load. This preserves the intent of the old <CurrentYear /> React component:
// any statically generated content is updated with the current date on the
// client, so a build that straddles a New Year boundary still shows the
// correct year.
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 py-6 pb-16 text-gray-400">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div>
        <ul class="list-none space-y-1 pl-0">
          <li><a class="text-gray-300" href="/contact/">Contact Us</a></li>
          <li><a class="text-gray-300" href="/learn/">Learn How to Code</a></li>
          <li><a class="text-gray-300" href="/puzzles/">Coding Puzzles</a></li>
        </ul>
      </div>
      <div>
        <ul class="list-none space-y-1 pl-0">
          <li><a class="text-gray-300" href="/jobs/">Jobs</a></li>
          <li><a class="text-gray-300" href="/about/">About</a></li>
          <li><a class="text-gray-300" href="/events/">Events</a></li>
        </ul>
      </div>
      <div>
        <div class="flex gap-4">
          <a
            href="https://github.com/codeselfstudy/codeselfstudy"
            class="text-gray-400 transition-colors hover:text-white"
            aria-label="GitHub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              role="img"
              viewBox="0 0 24 24"
              width="32"
              height="32"
              fill="currentColor"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
    <div
      class="mt-8 border-t border-gray-700 pt-8 text-center text-sm md:text-left"
    >
      <p>
        &copy; 2013&ndash;<span id="footer-year">{currentYear}</span>{" "}
        <a href="/" class="text-gray-300 hover:text-white">Code Self Study</a>{
          " "
        } &bull; Programming community in the San Francisco Bay Area, California
      </p>
      <p class="mt-2"></p>
    </div>
  </div>
</footer>

<script>
  // Refresh the build-time year on the client so a stale deploy stays correct.
  const el = document.getElementById("footer-year");
  if (el) {
    el.textContent = String(new Date().getFullYear());
  }
</script>
