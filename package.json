{
  "name": "codeselfstudy",
  "version": "3.0.0-beta.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "bun run --filter web dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run --filter web build",
    "build:web": "bun run --filter web build",
    "test": "bun run --filter web test",
    "test:web": "bun run --filter web test",
    "lint": "bun run --filter web lint",
    "format": "prettier --write '**/*.{md,mdx,ts,js,mjs,cjs,jsx,tsx,yaml,yml,json,html,css,scss,vue,astro}'",
    "check": "prettier --write . && bun run --filter web lint"
  },
  "devDependencies": {
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1"
  }
}
