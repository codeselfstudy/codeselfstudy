# Change filename to `.env.local` to use this file
# This file is only used in development

# PUBLIC CLIENT VARS ######################

# The Astro web app doesn't consume these yet (client-side WorkOS sign-in is
# deferred). They're kept because the Go server reads them as fallback names
# for its JWKS verifier (see apps/api/internal/auth).
VITE_WORKOS_CLIENT_ID=get_this_from_workos
VITE_WORKOS_API_HOSTNAME=api.workos.com


# PRIVATE SERVER VARS #####################

# Local SQLite file path used by the migrate CLI (apps/api/cmd/migrate)
# and by tests. The runtime server doesn't open the DB yet — that gets
# wired up when the first real DB-backed endpoint lands.
DATABASE_URL="dev.db"
WORKOS_API_KEY=get_this_from_workos
