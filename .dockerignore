.bun-version
.dockerignore
.gitignore
fly.toml

# Side projects / fixtures
manual/
mockups/
scripts/
dotfiles/
tmp/

# Web workspace source — only the prerendered output ships.
apps/web/src
apps/web/public
apps/web/test
apps/web/node_modules
apps/web/.tanstack
apps/web/dist
apps/web/.cta.json
apps/web/components.json
