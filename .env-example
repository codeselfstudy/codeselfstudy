# Copy this file to `.env.local` and fill out the values.
VITE_WORKOS_CLIENT_ID=client_...

# This should be your Custom Authentication Domain in production
VITE_WORKOS_API_HOSTNAME=api.workos.com

###############
# Server-only #
###############
DATABASE_URL="dev.db"
WORKOS_API_KEY="sk_test_..."

SLACK_WEBHOOK_FOR_DEALS_CHANNEL=https://hooks.slack.com/services/some-webhook-url...

JWT_SECRET=super_secret_jwt_secret

# Get this from https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
INGEST_TOKEN=secret_ingest_token

# Go durations (24h / 1080h); no d unit
DIGEST_INTERVAL=
REPOST_AFTER=

# The production server needs these:
# DATABASE_URL=
# TURSO_AUTH_TOKEN=

##############################
# Cloudflare Worker Env Vars #
##############################

# The Cloudflare worker also needs the same INGEST_TOKEN:
# INGEST_TOKEN=secret_ingest_token
# INGEST_URL=https://codeselfstudy.com/api/ingest
